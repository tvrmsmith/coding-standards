# Tvrmsmith.Analyzers — curated severities
#
# A global AnalyzerConfig (https://learn.microsoft.com/dotnet/fundamentals/code-analysis/configuration-files).
# It is applied two ways, and both must work:
#
#   1. NuGet consumption  — build/Tvrmsmith.Analyzers.props adds it.
#   2. Bare-dll injection — local/Tvrmsmith.Analyzers.Local.props adds it, reached through
#                           CustomAfterMicrosoftCommonProps.
#
# A .globalconfig shipped only inside the nupkg would not reach a bare <Analyzer Include>
# consumer, so it is staged to artifacts/local/ next to the DLLs as well.

is_global = true

# global_level is deliberately left at its default (0, the lowest). Anything the target repo
# states for itself — its own .editorconfig, or a global config it opts into — outranks these.
# These are a floor, not an override.

##
## AwesomeAssertions.Analyzers 9.0.8
##
## Pairing matters and fails silently: AwesomeAssertions 9.x <-> AwesomeAssertions.Analyzers,
## FluentAssertions 6.x <-> FluentAssertions.Analyzers. The diagnostic IDs and these
## editorconfig keys are identical across both packages, so this block is portable. Get the
## pairing wrong and the analyzer gates on a type name that does not exist: zero diagnostics,
## no warning, a run that looks clean.
##
## All four ship as Info, which never surfaces in a normal build. The enforcement mapping
## makes them the off-the-shelf home for four guidelines, so Info is too
## quiet — they are elevated to warning. Not error: adoption is machine-local with no CI
## gate, and an error would block builds of code nobody else is being asked to change.
##

# FAA0001 "Simplify Assertion" — clean up FluentAssertion usage.
# Enforcement home for: A2 (assertions communicate intent), B2 (collections:
# BeEquivalentTo/ContainSingle over Count checks), B3 (expressive chains).
dotnet_diagnostic.FAA0001.severity = warning

# FAA0002 — replace an Xunit assertion with the Fluent Assertions equivalent.
dotnet_diagnostic.FAA0002.severity = warning

# FAA0003 — replace an MSTest assertion with the Fluent Assertions equivalent.
dotnet_diagnostic.FAA0003.severity = warning

# FAA0004 — replace an NUnit assertion with the Fluent Assertions equivalent.
dotnet_diagnostic.FAA0004.severity = warning

# ffa_excluded_methods is deliberately unset. It suppresses FAA0002-FAA0004 for named
# assertion methods (e.g. M:NUnit.Framework.Assert.Fail); nothing in scope needs an exemption.

##
## Tvrmsmith custom analyzers
##
## The guidelines the enforcement mapping found no off-the-shelf home
## for. All of them already default to warning in their DiagnosticDescriptor; they are restated
## here so the severity of every rule this package is responsible for is readable in one place,
## and so raising or lowering one is a config edit rather than a rebuild.
##
## Warning, never error, for the same reason as the block above: this runs machine-locally
## against code other people wrote and are not being asked to change.
##

# TVRM0001 combine-assertions-on-same-object — enforcement home for A1 and B1.
dotnet_diagnostic.TVRM0001.severity = warning

# TVRM0002 no-suppression-before-assertion — enforcement home for the C# half of A4, and B7.
dotnet_diagnostic.TVRM0002.severity = warning

# TVRM0003 no-assertion-escape-cast — enforcement home for C2. The judgment half of that
# guideline, C1 (which target to assert on instead), stays review-only in the skill text.
dotnet_diagnostic.TVRM0003.severity = warning

# TVRM0004 no-assertion-without-matcher — enforcement home for one of the three shapes under A5.
dotnet_diagnostic.TVRM0004.severity = warning

# TVRM0005 no-dropped-async-assertion — the second A5 shape, in the synchronous test bodies
# CS4014 cannot reach. The third shape, an assertion inside a branch, stays review-only: measured
# against the adoption target it is dominated by legitimate idioms.
dotnet_diagnostic.TVRM0005.severity = warning

# --- BEGIN generated: built-in CA severities (node dotnet/generate-ca-severities.mjs) ---
#
# The 262 CA rules the .NET SDK ships *quiet*, minus 25 exclusions.
# Quiet means the build shows nothing without this file: 125 of them are disabled
# outright, and 137 are enabled at note (DiagnosticSeverity.Info), which MSBuild does not
# print and TreatWarningsAsErrors never touches. Both are raised the same way and for the same
# reason the FAA block above raises its four.
#
# The CA rules that already report at warning or error are deliberately left alone: raising
# them here would also let the changed-files scoping mute them, which would reduce what the
# target repo already reports. A quiet rule reports nothing today, so scoping it costs nothing.
#
# No <Analyzer Include> backs these. The SDK already loads the analyzers; a globalconfig
# configures severity by id and does not care which assembly emits the diagnostic. Setting
# an explicit severity is also what *enables* a rule that ships disabled, which is why this
# reaches the same rules as <AnalysisMode>All</AnalysisMode> without injecting that property.
#
# Warning, never error, for the same reason as every block above.
#
# Excluded, and why:
#   CA2007  ConfigureAwait: 62 Microsoft.NET.Sdk.Web projects, and ASP.NET Core has no SynchronizationContext, so the fix is a no-op
#   CA1812  uninstantiated internal class: the DI container instantiates them, so every hit is a false positive
#   CA2227  read-only collection properties break JSON deserialization targets
#   CA1002  do not expose List<T>: DTOs need it for deserialization
#   CA1819  properties returning arrays: same, fights the DTO shape
#   CA1062  validate public arguments: duplicates the compiler null analysis where nullable is on
#   CA5391  antiforgery on MVC controllers: 3 .cshtml files against 119 [ApiController], so no form surface to protect
#   CA1303  literals as localized parameters: nothing here is localized
#   CA1724  type name matches namespace: unavoidable and harmless in a monorepo this shape
#   CA1515  make public types internal: aimed at apps, wrong for cross-project consumption
#   CA1707  no underscores in member names: every one of the 7676 hits is a test method, and the naming convention it objects to is the one test-best-practices teaches
#   CA1014  CLSCompliant attribute: dead concern for modern C#
#   CA1017  ComVisible attribute: same
#   CA1716  identifiers should not match keywords: the keywords are VB ones, so this is CLS interop again
#   CA2235  non-serializable fields: legacy ISerializable
#   CA2237  mark ISerializable types: legacy ISerializable
#   CA2000  dispose before losing scope: misreads ownership transfer throughout DI and builder code
#   CA1024  use properties where appropriate: a GetX() method often signals expense on purpose
#   CA1027  mark enums with Flags: guesses intent from values happening to be powers of two
#   CA1028  enum storage Int32: wrong whenever byte was chosen for a wire format
#   CA1030  use events where appropriate: a naming heuristic on Fire*/Raise*
#   CA1814  jagged over multidimensional arrays: situational
#   CA2225  operator named alternates: CLS/VB interop, effectively dead
#   CA1711  incorrect type-name suffix: 54 of 58 hits demand renaming a *EventHandler, which is the right name for a domain event handler
#   CA1720  identifier contains type name: half the hits are the substring misfire on Signed

