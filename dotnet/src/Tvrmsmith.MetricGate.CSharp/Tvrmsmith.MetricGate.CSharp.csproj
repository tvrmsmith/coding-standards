<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      net8.0 makes the runtimeconfig ask for Microsoft.NETCore.App 8.0.0, and the
      host's default Minor roll-forward climbs inside 8.x without ever crossing a
      major, so the packed tool's shim could not launch on a machine carrying only
      a 10 runtime even though a 10 SDK builds it. Major is purely additive: the
      target framework stays net8.0, a machine with an 8.x runtime still selects
      8.x, and the only new outcome is that a 10-only machine launches the tool
      instead of failing.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup Label="Tool packaging">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>metric-gate-csharp</ToolCommandName>
    <PackageId>Tvrmsmith.MetricGate.CSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Trevor Smith</Authors>
    <Description>
      C# complexity extractor for metric-gate. Parses source with Roslyn's syntax parser alone
      (no semantic model, no MSBuild) and emits one span per declaration the compiler gives a body
      to, which is every declaration carrying a body or an expression body, plus an auto-property
      accessor.
    </Description>
    <RepositoryUrl>https://github.com/tvrmsmith/coding-standards</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
