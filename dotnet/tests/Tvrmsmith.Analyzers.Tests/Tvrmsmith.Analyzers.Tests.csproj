<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Microsoft.CodeAnalysis.Testing. Each test spins up a real compilation, so the analyzers
         are exercised against bound symbols rather than syntax alone — which is the half that
         matters here: every rule gates on Should() resolving to an extension method returning an
         *Assertions type. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />

    <!-- Pin Roslyn to the version the analyzers are compiled against. The testing package pulls
         an older one, and the analyzers would then run against an API surface they were not
         built for. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />

    <!-- Not compiled against — resolved as a metadata reference for the test compilations, so
         .Should() binds to the same FluentAssertions a consuming repo pins. -->
    <PackageReference Include="FluentAssertions" Version="$(FluentAssertionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="analyzers" so FluentAssertions.Analyzers, which the analyzer project
         deliberately flows to its consumers, does not also analyse this project. -->
    <ProjectReference Include="../../src/Tvrmsmith.Analyzers/Tvrmsmith.Analyzers.csproj"
                      ExcludeAssets="analyzers" />
  </ItemGroup>

</Project>
