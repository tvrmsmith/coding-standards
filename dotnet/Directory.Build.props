<Project>

  <PropertyGroup>
    <!-- The single stable path phase-1 injection points at. Kept out of the project file so
         the consumer test can read it too. -->
    <DotnetRoot>$(MSBuildThisFileDirectory)</DotnetRoot>
    <LocalArtifactsDir>$(DotnetRoot)artifacts/local/</LocalArtifactsDir>

    <!-- The curated severities in
         src/Tvrmsmith.Analyzers/config/Tvrmsmith.Analyzers.globalconfig are written against this
         version's FAA0001-FAA0004. The fork kept the FAA prefix, so those ids carry over from
         FluentAssertions.Analyzers unchanged. Bump both together. -->
    <AwesomeAssertionsAnalyzersVersion>9.0.8</AwesomeAssertionsAnalyzersVersion>

    <!-- AwesomeAssertions is the assumed baseline, which is why the analyzer pairing is
         AwesomeAssertions.Analyzers and not FluentAssertions.Analyzers. It is the Apache-2.0
         community fork of FluentAssertions 7; FluentAssertions 8 moved to a licence that bills
         commercial users, and this repo's own suite is the worked example of its standards. -->
    <AwesomeAssertionsVersion>9.6.0</AwesomeAssertionsVersion>
  </PropertyGroup>

</Project>
